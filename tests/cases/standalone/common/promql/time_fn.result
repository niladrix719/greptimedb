-- date functions read sample values as Unix seconds, not the evaluation time
create table date_samples (ts timestamp time index, host string primary key, val double);

Affected Rows: 0

-- 1970-01-01T00:02:00Z, 2024-02-29T13:45:30Z, 2023-12-31T23:59:59.9Z, NaN
insert into date_samples values (0, 'a', 120), (5000, 'a', 1709214330), (0, 'b', 1704067199.9), (5000, 'b', 'NaN'::DOUBLE);

Affected Rows: 4

-- SQLNESS SORT_RESULT 3 1
tql eval (0, 5, '5s') minute(date_samples);

+---------------------+-------------------------------+------+
| ts                  | date_part(Utf8("minute"),val) | host |
+---------------------+-------------------------------+------+
| 1970-01-01T00:00:00 | 2                             | a    |
| 1970-01-01T00:00:00 | 59                            | b    |
| 1970-01-01T00:00:05 | 45                            | a    |
+---------------------+-------------------------------+------+

-- SQLNESS SORT_RESULT 3 1
tql eval (0, 5, '5s') hour(date_samples);

+---------------------+-----------------------------+------+
| ts                  | date_part(Utf8("hour"),val) | host |
+---------------------+-----------------------------+------+
| 1970-01-01T00:00:00 | 0                           | a    |
| 1970-01-01T00:00:00 | 23                          | b    |
| 1970-01-01T00:00:05 | 13                          | a    |
+---------------------+-----------------------------+------+

-- SQLNESS SORT_RESULT 3 1
tql eval (0, 5, '5s') month(date_samples);

+---------------------+------------------------------+------+
| ts                  | date_part(Utf8("month"),val) | host |
+---------------------+------------------------------+------+
| 1970-01-01T00:00:00 | 1                            | a    |
| 1970-01-01T00:00:00 | 12                           | b    |
| 1970-01-01T00:00:05 | 2                            | a    |
+---------------------+------------------------------+------+

-- SQLNESS SORT_RESULT 3 1
tql eval (0, 5, '5s') year(date_samples);

+---------------------+-----------------------------+------+
| ts                  | date_part(Utf8("year"),val) | host |
+---------------------+-----------------------------+------+
| 1970-01-01T00:00:00 | 1970                        | a    |
| 1970-01-01T00:00:00 | 2023                        | b    |
| 1970-01-01T00:00:05 | 2024                        | a    |
+---------------------+-----------------------------+------+

-- SQLNESS SORT_RESULT 3 1
tql eval (0, 5, '5s') day_of_month(date_samples);

+---------------------+----------------------------+------+
| ts                  | date_part(Utf8("day"),val) | host |
+---------------------+----------------------------+------+
| 1970-01-01T00:00:00 | 1                          | a    |
| 1970-01-01T00:00:00 | 31                         | b    |
| 1970-01-01T00:00:05 | 29                         | a    |
+---------------------+----------------------------+------+

-- SQLNESS SORT_RESULT 3 1
tql eval (0, 5, '5s') day_of_week(date_samples);

+---------------------+----------------------------+------+
| ts                  | date_part(Utf8("dow"),val) | host |
+---------------------+----------------------------+------+
| 1970-01-01T00:00:00 | 0                          | b    |
| 1970-01-01T00:00:00 | 4                          | a    |
| 1970-01-01T00:00:05 | 4                          | a    |
+---------------------+----------------------------+------+

-- SQLNESS SORT_RESULT 3 1
tql eval (0, 5, '5s') day_of_year(date_samples);

+---------------------+----------------------------+------+
| ts                  | date_part(Utf8("doy"),val) | host |
+---------------------+----------------------------+------+
| 1970-01-01T00:00:00 | 1                          | a    |
| 1970-01-01T00:00:00 | 365                        | b    |
| 1970-01-01T00:00:05 | 60                         | a    |
+---------------------+----------------------------+------+

-- SQLNESS SORT_RESULT 3 1
tql eval (0, 5, '5s') days_in_month(date_samples);

+---------------------+-------------------------------------------------------------------------------------------------------------------------------------------------+------+
| ts                  | date_part(Utf8("day"),date_trunc(Utf8("month"),val) + IntervalYearMonth("1") - IntervalDayTime("IntervalDayTime { days: 1, milliseconds: 0 }")) | host |
+---------------------+-------------------------------------------------------------------------------------------------------------------------------------------------+------+
| 1970-01-01T00:00:00 | 31                                                                                                                                              | a    |
| 1970-01-01T00:00:00 | 31                                                                                                                                              | b    |
| 1970-01-01T00:00:05 | 29                                                                                                                                              | a    |
+---------------------+-------------------------------------------------------------------------------------------------------------------------------------------------+------+

drop table date_samples;

